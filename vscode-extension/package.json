{
  "name": "portable-agent-protocol",
  "displayName": "Portable Agent Protocol",
  "description": "Official VS Code tooling for Portable Agent Protocol workspaces",
  "version": "0.1.0",
  "publisher": "portable-agent",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pap.initWorkspace",
        "title": "PAP: Initialize Workspace"
      },
      {
        "command": "pap.mcpSync",
        "title": "PAP: Sync MCP Servers"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "**/.agent/agent.md",
          "**/agent.md"
        ],
        "url": "https://raw.githubusercontent.com/OPluke11-abula/Portable-Agent-Protocol/main/schemas/agent-schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3"
  }
}
