{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/OPluke11-abula/Portable-Agent-Protocol/main/spec/review-findings.schema.json",
  "title": "Portable Agent Protocol Structured Review and Security Findings Schema",
  "description": "Report-only schema for code review and security findings. It records verdicts, severity, source traces, impact, exploit paths for high-risk findings, remediation, and validation status without enabling parallel audit agents by default.",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "review_type",
    "execution_policy",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v?\\d+\\.\\d+\\.\\d+$"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "review_type": {
      "type": "string",
      "enum": [
        "code_review",
        "security",
        "architecture",
        "compliance",
        "workflow_gate"
      ]
    },
    "execution_policy": {
      "$ref": "#/$defs/execution_policy"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "execution_policy": {
      "type": "object",
      "required": [
        "mode",
        "parallel_audit_agents"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "report_only"
          ]
        },
        "parallel_audit_agents": {
          "const": false
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "verdict",
        "severity",
        "title",
        "source_trace",
        "impact",
        "remediation",
        "validation_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs_review",
            "not_applicable"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string"
        },
        "source_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_trace"
          }
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "exploit_path": {
          "$ref": "#/$defs/exploit_path"
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "unvalidated",
            "validated",
            "mitigated",
            "false_positive",
            "accepted_risk"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "severity": {
                "enum": [
                  "high",
                  "critical"
                ]
              }
            },
            "required": [
              "severity"
            ]
          },
          "then": {
            "required": [
              "exploit_path",
              "impact"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "source_trace": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "exploit_path": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
